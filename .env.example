# ---- Database (SQLite via better-sqlite3) ----
# Relative `file:` paths resolve from the repo root. Use an absolute path in
# production deployments.
DATABASE_URL=file:./db/app.db

# ---- Site ----
# Canonical public origin — used for metadataBase, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
